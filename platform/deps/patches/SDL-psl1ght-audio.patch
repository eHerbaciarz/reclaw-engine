+/* ReClaw: the blocks are written a few ahead of the one the hardware reads
+   (its read index), not simply one after another: the writing used to start
+   at the block being played and stayed in step with it only through the
+   events, so it wrote into or just behind the playing block - crackling. */
+static int
+PSL1GHT_ReadBlock(_THIS)
 {
-	
-	//deprintf( "PSL1GHT_AUD_GetDeviceBuf(%08X.%08X) at %d ms\n", SHW64(this), SDL_GetTicks());
+    return (int)(*(volatile u64 *)(u64)_config.readIndex % _config.numBlocks);
+}
 
-    //int playing = _config.readIndex;
-    // int playing = *((u64*)(u64)_config.readIndex);
-    int filling = (_last_filled_buf + 1) % _config.numBlocks;
-	Uint8 * dma_buf = (Uint8 *)(u64)_config.audioDataStart;
-	//deprintf( "\tWriting to buffer %d \n", filling);
-	// deprintf( "\tbuffer address (%08X.%08X => %08X.%08X)\n", SHW64(_config.audioDataStart), SHW64(dma_buf));
+static int
+PSL1GHT_Lead(_THIS)
+{
+    /* blocks written ahead of the one being read */
+    const int n = (int)_config.numBlocks;
+    return (_last_filled_buf - PSL1GHT_ReadBlock(this) + n) % n;
+}
 
-	_last_filled_buf = filling;
+static Uint8 *
+PSL1GHT_AUD_GetDeviceBuf(_THIS)
+{
+    const int n = (int)_config.numBlocks;
+    const int lead = PSL1GHT_Lead(this);
+    /* the hardware passed the written blocks (or at the start): again two
+       blocks ahead of it (the most written ahead normally is n - 3) */
+    if (lead > n - 3)
+        _last_filled_buf = (PSL1GHT_ReadBlock(this) + 1) % n;
+    int filling = (_last_filled_buf + 1) % n;
+    Uint8 * dma_buf = (Uint8 *)(u64)_config.audioDataStart;
+    _last_filled_buf = filling;
     return (dma_buf + (filling * this->spec.size));
 }
 
