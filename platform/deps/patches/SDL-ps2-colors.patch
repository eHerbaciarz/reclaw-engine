+/* ReClaw: on the GS 0x80 is 1.0 for alpha and for the colour a texture is
+   multiplied by (0xFF draws twice as bright and blends past opaque). */
+static inline Uint8 PS2_Half(Uint8 c)
+{
+    return (Uint8)((c + 1) >> 1);
+}
