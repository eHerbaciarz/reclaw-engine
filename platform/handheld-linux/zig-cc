#!/bin/sh
# C / C++ compiler wrapper: zig cc for an old glibc, so the binary runs on
# older handheld firmwares too. ZIG_TARGET e.g. aarch64-linux-gnu.2.27
case "$(basename "$0")" in
  zig-c++) exec python3 -m ziglang c++ -target "$ZIG_TARGET" "$@" ;;
  zig-ar) exec python3 -m ziglang ar "$@" ;;
  zig-ranlib) exec python3 -m ziglang ranlib "$@" ;;
  *) exec python3 -m ziglang cc -target "$ZIG_TARGET" "$@" ;;
esac
