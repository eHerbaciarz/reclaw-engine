<Actor Type="Level4_Katherine" Parent="ActorPrototype_BaseEnemy" ActorPrototypeName="ActorPrototype_Level4_Katherine">
    <ActorRenderComponent>
        <ImagePath>/LEVEL4/IMAGES/KATHERINE/*</ImagePath>
        <Palette>/LEVEL4/PALETTES/MAIN.PAL</Palette>
    </ActorRenderComponent>
    <AnimationComponent>
        <AnimationPath>/LEVEL4/ANIS/KATHERINE/*.ANI</AnimationPath>
    </AnimationComponent>
    <HealthComponent>
        <!-- CLAW.EXE: every boss has 100 HP against a 5-point sword; ReClaw's sword hits for 10, so 200 keeps the same 20 sword hits -->
        <Health>200</Health>
        <MaxHealth>200</MaxHealth>
    </HealthComponent>
    <LootComponent>
        <Item>60</Item>
    </LootComponent>
    <EnemyAIComponent>
        <DeathAnimation>idle</DeathAnimation>
        <Sounds>
            <Sound SoundType="Death" SoundName="/LEVEL4/SOUNDS/KATHERINE/00470002.WAV" />
            <Sound SoundType="TakeDamage" SoundName="/LEVEL1/SOUNDS/HIT1.WAV" />
        </Sounds>
    </EnemyAIComponent>
    <TakeDamageAIStateComponent>
        <StatePriority>0</StatePriority>
        <TakeDamageAnimation>hithigh</TakeDamageAnimation>
        <InvulnerabilityTime>1000</InvulnerabilityTime>
    </TakeDamageAIStateComponent>
    <!-- CLAW.EXE (0x456160, 0x456290): projectiles always deflected, sword blows blocked 6 times in 10 -->
    <ParryEnemyAIStateComponent>
        <StatePriority>0</StatePriority>
        <ParryChances>
            <ParryChance DamageType="DamageType_Bullet" Chance="100" />
            <ParryChance DamageType="DamageType_Magic" Chance="100" />
            <ParryChance DamageType="DamageType_Explosion" Chance="100" />
            <ParryChance DamageType="DamageType_MeleeAttack" Chance="60" />
        </ParryChances>
        <ParrySounds>
            <ParrySound>/LEVEL4/SOUNDS/KATHERINE/BLOCK1.WAV</ParrySound>
            <ParrySound>/LEVEL4/SOUNDS/KATHERINE/BLOCK2.WAV</ParrySound>
        </ParrySounds>
        <ParryAnimFrameIdx>0</ParryAnimFrameIdx>
        <ParryAnimation>blockhigh</ParryAnimation>
    </ParryEnemyAIStateComponent>
    <PatrolEnemyAIStateComponent>
        <IsAlwaysIdle>false</IsAlwaysIdle>
        <StatePriority>0</StatePriority>
        <PatrolSpeed>1.700000</PatrolSpeed>
        <LeftPatrolBorder>0</LeftPatrolBorder> <!-- DEFINED IN CODE -->
        <RightPatrolBorder>0</RightPatrolBorder> <!-- DEFINED IN CODE -->
        <RetainDirection>false</RetainDirection>
        <WalkAction>
            <Animation>walk</Animation>
        </WalkAction>
    </PatrolEnemyAIStateComponent>
    <MeleeAttackAIStateComponent>
        <StatePriority>20</StatePriority>
        <Attacks>
            <AttackAction>
                <Animation>strike1</Animation>
                <AttackAnimFrameIdx>6</AttackAnimFrameIdx>
                <AttackType>0</AttackType>
                <AttackFxImageSet>NONE</AttackFxImageSet>
                <AttackSpawnPositionOffset x="-100" y="0" />
                <AttackAreaSize width="200" height="50" />
                <Damage>10</Damage>
                <AgroSensorFixture>
                    <FixtureType>EnemyAIMeleeSensor</FixtureType>
                    <CollisionShape>Rectangle</CollisionShape>
                    <IsSensor>true</IsSensor>
                    <Size width="400" height="50" />
                    <Offset x="0" y="0" />
                    <CollisionFlag>4</CollisionFlag>
                    <CollisionMask>2</CollisionMask>
                    <Friction>0.000000</Friction>
                    <Density>0.000000</Density>
                    <Restitution>0</Restitution>
                </AgroSensorFixture>
            </AttackAction>
        </Attacks>
    </MeleeAttackAIStateComponent>
    <!-- CLAW.EXE 0x456550: a flip that puts 200-400 px between her and Claw -->
    <LeapAIStateComponent>
        <StatePriority>30</StatePriority>
        <Mode>Away</Mode>
        <Animation>flip</Animation>
        <Sound>/LEVEL4/SOUNDS/KATHERINE/FLIP1.WAV</Sound>
        <MinDistance>200</MinDistance>
        <MaxDistance>400</MaxDistance>
        <!-- CLAW.EXE 0x456060: when Claw swings at her from the front within
             150 px, one time in five she flips away (0x456550) -->
        <OnClawAttack>true</OnClawAttack>
        <Chance>20</Chance>
        <ClawMaxRange>150</ClawMaxRange>
        <CooldownMs>1000</CooldownMs>
    </LeapAIStateComponent>
    <KatherineBossAIStateComponent>
        <StatePriority>100</StatePriority>
        <BossDialogAnimation>idle</BossDialogAnimation>
    </KatherineBossAIStateComponent>
</Actor>